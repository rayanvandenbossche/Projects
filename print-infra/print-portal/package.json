{
  "name": "print-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max_old_space_size=4096 next dev -H 0.0.0.0",
    "build": "cross-env NODE_OPTIONS=--max_old_space_size=4096 next build",
    "start": "cross-env NODE_ENV=production node server.js",
    "scheduler": "cross-env NODE_ENV=production tsx scripts/scheduler.ts",
    "update": "powershell -ExecutionPolicy Bypass -File .\\update.ps1",
    "lint": "eslint"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@prisma/client": "^5.22.0",
    "adm-zip": "^0.5.17",
    "autoprefixer": "^10.4.27",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "ip-cidr": "^4.0.2",
    "isomorphic-fetch": "^3.0.0",
    "lucide-react": "^1.7.0",
    "mammoth": "^1.12.0",
    "net-snmp": "^3.26.1",
    "next": "^16.2.6",
    "next-auth": "^4.24.13",
    "playwright": "^1.59.1",
    "postcss": "^8.5.8",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
